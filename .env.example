# =============================================================================
# OUTREACH ENGINE — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control. NEVER bake it into the Docker image.
# All secrets below are server-side only — none are exposed to the browser.
# =============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# The domain Caddy issues a TLS certificate for. Must already resolve to this
# server. Leave as `localhost` for local testing (self-signed cert).
APP_DOMAIN=localhost

# --- Database --------------------------------------------------------------
# Used by docker-compose to initialise Postgres. Generate the password with:
#   openssl rand -base64 24
POSTGRES_USER=outreach
POSTGRES_PASSWORD=
POSTGRES_DB=outreach

# The app's own connection string.
#   docker compose : postgres://outreach:<password>@db:5432/outreach
#   local dev      : postgres://outreach:outreach@localhost:5432/outreach
# docker-compose overrides this for the web and worker containers, so in
# production it only needs to be correct if you run the app outside Docker.
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach

# --- Auth (Auth.js) --------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Anthropic (Claude) ----------------------------------------------------
ANTHROPIC_API_KEY=

# Model assignment per operation. Editable from the dashboard at runtime;
# these are the boot defaults used when no DB setting exists yet.
AI_MODEL_RESEARCH=claude-haiku-4-5
AI_MODEL_EMAIL_GEN=claude-sonnet-5
AI_MODEL_FOLLOWUP=claude-haiku-4-5
AI_MODEL_CLASSIFY=claude-haiku-4-5

# Hard monthly spend controls (USD). Enforced in code before every AI call.
AI_MONTHLY_BUDGET_WARN=16.00
AI_MONTHLY_BUDGET_STOP=20.00

# --- Email sending ---------------------------------------------------------
# Which provider implementation to load: resend | smartlead | smtp | console
EMAIL_PROVIDER=resend

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Smartlead (used at Phase 2/3 scale — inbox rotation + managed warm-up)
SMARTLEAD_API_KEY=

# Generic SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Contact enrichment ----------------------------------------------------
# Which provider implementation to load: hunter | apollo | none
ENRICHMENT_PROVIDER=hunter
HUNTER_API_KEY=
APOLLO_API_KEY=

# --- Autonomous lead sourcing ----------------------------------------------
# Which provider finds companies that are hiring: apollo | none
# 'none' disables the daily source_leads job entirely; CSV import still works.
# Apollo's search API requires a paid plan with API access enabled.
# What it hunts for, the daily cap, and the on/off switches live in the
# dashboard (Settings → sourcing), not here.
SOURCING_PROVIDER=none

# --- Sending safety limits -------------------------------------------------
# Global ceiling across all inboxes. Per-domain and per-inbox caps live in the DB
# and are editable from the dashboard.
GLOBAL_DAILY_SEND_LIMIT=50
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
SEND_TIMEZONE=Asia/Kolkata

# --- Worker ----------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3

# --- Notifications ---------------------------------------------------------
# Where Tier-3 (stop + wait) alerts are emailed
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Backups (optional; DigitalOcean Spaces / any S3-compatible store) ------
BACKUP_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
